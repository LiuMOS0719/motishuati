# 墨题 Node 服务（与旧 Python 站并行，只监听 8091）
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
    TZ=Asia/Shanghai \
    NODE_ENV=production \
    PATH=/opt/node/bin:$PATH

# Node 20.18.1 arm64（构建上下文里的离线包，不依赖容器内网络）
ADD build/node.tgz /opt/
RUN mv /opt/node-v20.18.1-linux-arm64 /opt/node && node -v && npm -v

WORKDIR /app

# 依赖层单独缓存：只有 package.json 变了才重装
COPY server/package.json ./server/
RUN cd server && npm install --omit=dev --no-audit --no-fund \
      --registry=https://registry.npmmirror.com && npm cache clean --force

COPY server/ ./server/
COPY app/static/ ./public/

RUN useradd -r -u 10001 -s /sbin/nologin moti \
 && chown -R moti:moti /app
USER moti

EXPOSE 8091
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:8091/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "server/index.js"]
